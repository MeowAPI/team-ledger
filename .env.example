# Copy to .env. Never commit real tokens.
HOST=127.0.0.1
PORT=8765
PUBLIC_URL=http://127.0.0.1:8765
COOKIE_SECURE=false
TEAM_TIMEZONE=Asia/Shanghai
# DATA_DIR=./data

# Optional Telegram integration. Run ONE bot worker per database.
TELEGRAM_BOT_TOKEN=
# Optional proxy, e.g. http://127.0.0.1:7890
TELEGRAM_PROXY_URL=

# Optional OpenAI-compatible Chat Completions endpoint (include /v1 if required).
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# json_object or json_schema, according to your provider's support.
AI_RESPONSE_FORMAT=json_object
# Multi-action assistant limits.
AI_TIMEOUT=40
AI_CONTEXT_ENTRIES=120
AI_CONTEXT_CHARS=60000
AI_MAX_ACTIONS=20

# Daily reference exchange rates. No API key needed.
FX_API_URL=https://api.frankfurter.app/latest
FX_CACHE_HOURS=12
